    "terminal.ansiBrightGreen": "#9AD6B0",
    "terminal.ansiYellow": "#E8AD62",
    "terminal.ansiBrightYellow": "#F0C68C",
    "terminal.ansiBlue": "#6fbf8e",
    "terminal.ansiBrightBlue": "#9ad2b0",
    "terminal.ansiMagenta": "#eab69d",
    "terminal.ansiBrightMagenta": "#f0ccba",
    "terminal.ansiCyan": "#8ccb9f",
    "terminal.ansiBrightCyan": "#afdbbc",
    "terminal.ansiWhite": "#dfe1d9",
    "terminal.ansiBrightWhite": "#f4f2ea"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9a8f7e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#6fbf8e"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#E07A4F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#F6B5A0"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#6fbf8e"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#6fbf8e"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#d6d3ba"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#d6d3ba"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d6d3ba",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e8ad62"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F6B5A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F6B5A0"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e07a4f",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#d6d3ba",
    "method": "#d6d3ba",
    "class": {
      "foreground": "#F6B5A0",
      "italic": true
    },
    "type": {
      "foreground": "#F6B5A0",
      "italic": true
    },
    "interface": {
      "foreground": "#F6B5A0",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#F6B5A0",
      "italic": true
    },
    "enum": {
      "foreground": "#F6B5A0",
      "italic": true
    },
    "enumMember": {
      "foreground": "#e07a4f",
      "italic": true
    },
    "property.declaration": "#f4f2ea",
    "parameter": {
      "italic": true
    },
    "property": "#f4f2ea"
  }
}
