    "modernEditorTab.hoverBackground": "#122a24",
    "modernEditorTab.hoverForeground": "#ece8d4",
    "modernTab.activeBackground": "#245d4daa",
    "modernTab.activeForeground": "#ece8d4",
    "modernTab.hoverBackground": "#122a24",
    "modernTab.hoverForeground": "#ece8d4",
    "modernPanel.border": "#122a24",
    "modernUI.shellBackground": "#0a1412",
    "terminalCursor.foreground": "#ECE8D4",
    "terminal.selectionBackground": "#245d4d99",
    "terminal.findMatchBackground": "#4fc9a655",
