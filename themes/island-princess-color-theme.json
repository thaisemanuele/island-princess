    "widget.border": "#2c302c",
    "textCodeBlock.background": "#1f2925",
    "toolbar.hoverBackground": "#2c302c",
    "foreground": "#e1ded6",
    "descriptionForeground": "#9a9891",
    "icon.foreground": "#adaaa3",
    "sideBar.foreground": "#d4d1c9",
    "sideBar.border": "#0d100f",
    "sideBarTitle.foreground": "#adaaa3",
    "sideBarSectionHeader.background": "#0d100f",
    "sideBarSectionHeader.foreground": "#adaaa3",
    "sideBarSectionHeader.border": "#142722",
    "list.activeSelectionForeground": "#f3f0e8",
    "list.inactiveSelectionBackground": "#142722",
    "list.inactiveSelectionForeground": "#e1ded6",
    "list.hoverForeground": "#f3f0e8",
    "tree.indentGuidesStroke": "#2c302c",
    "activityBar.inactiveForeground": "#A8A493",
    "tab.activeForeground": "#f3f0e8",
    "tab.inactiveForeground": "#807f78",
    "tab.border": "#0d100f",
    "titleBar.activeForeground": "#adaaa3",
    "statusBar.foreground": "#adaaa3",
    "panelTitle.activeForeground": "#f3f0e8",
    "panelTitle.inactiveForeground": "#807f78",
    "panelTitle.activeBorder": "#EE9064",
    "terminal.foreground": "#f3f0e8",
    "activityBarTop.foreground": "#EE9064",
    "activityBarTop.inactiveForeground": "#A8A493",
    "activityBarTop.activeBorder": "#EE9064",
    "modernActivityBarItem.activeForeground": "#EE9064",
    "modernActivityBarItem.activeBackground": "#1E3A33",
    "modernActivityBarItem.hoverForeground": "#EE9064",
    "modernActivityBarItem.hoverBackground": "#142722",
    "modernActivityBar.border": "#142722",
    "modernEditorTab.activeBackground": "#131715",
    "modernEditorTab.activeForeground": "#f3f0e8",
    "modernEditorTab.inactiveBackground": "#0d100f",
    "modernEditorTab.hoverBackground": "#142722",
    "modernEditorTab.hoverForeground": "#f3f0e8",
    "modernTab.activeBackground": "#245d4daa",
    "modernTab.activeForeground": "#f3f0e8",
    "modernTab.hoverBackground": "#142722",
    "modernTab.hoverForeground": "#f3f0e8",
    "modernPanel.border": "#142722",
    "modernUI.shellBackground": "#0d100f",
    "terminalCursor.foreground": "#F3F0E8",
    "terminal.selectionBackground": "#245d4d99",
    "terminal.findMatchBackground": "#ee906455",
    "gitDecoration.modifiedResourceForeground": "#f0a27c",
    "gitDecoration.stageModifiedResourceForeground": "#f0a27c",
    "gitDecoration.untrackedResourceForeground": "#86cbbe",
    "gitDecoration.addedResourceForeground": "#86cbbe",
    "gitDecoration.renamedResourceForeground": "#86cbbe",
    "gitDecoration.deletedResourceForeground": "#f08a9a",
    "gitDecoration.stageDeletedResourceForeground": "#f08a9a",
    "gitDecoration.conflictingResourceForeground": "#f08a9a",
    "gitDecoration.ignoredResourceForeground": "#504f49",
    "gitDecoration.submoduleResourceForeground": "#adaaa3",
    "editorGutter.modifiedBackground": "#f0a27c",
    "editorGutter.addedBackground": "#86cbbe",
    "editorGutter.deletedBackground": "#f08a9a",
    "editor.findMatchHighlightBackground": "#f0a27c22",
    "editor.wordHighlightBackground": "#f0a27c1f",
    "editor.selectionHighlightBackground": "#f0a27c1f",
    "textLink.foreground": "#f0a27c",
    "textLink.activeForeground": "#f5bea3",
    "editorIndentGuide.background1": "#222724",
    "editorIndentGuide.activeBackground1": "#4a4840",
    "terminal.ansiBlack": "#2c302c",
    "terminal.ansiBrightBlack": "#807f78",
    "terminal.ansiRed": "#EE9064",
    "terminal.ansiBrightRed": "#F4AE8C",
    "terminal.ansiGreen": "#86CBBE",
    "terminal.ansiBrightGreen": "#C4E8E0",
    "terminal.ansiYellow": "#E8AD62",
    "terminal.ansiBrightYellow": "#F0C68C",
    "terminal.ansiBlue": "#ee9064",
    "terminal.ansiBrightBlue": "#f3b193",
    "terminal.ansiMagenta": "#eecfa5",
    "terminal.ansiBrightMagenta": "#f3ddc0",
    "terminal.ansiCyan": "#f0a27c",
    "terminal.ansiBrightCyan": "#f5bea3",
    "terminal.ansiWhite": "#e1ded6",
    "terminal.ansiBrightWhite": "#f3f0e8"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#958f80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ee9064"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#E07148",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#E8AD62"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#ee9064"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ee9064"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#86cbbe"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#86cbbe"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#86cbbe",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ded5b4"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E8AD62",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E8AD62"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e8ad62",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#86cbbe",
    "method": "#86cbbe",
    "class": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "type": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "interface": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "enum": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "enumMember": {
      "foreground": "#e8ad62",
      "italic": true
    },
    "property.declaration": "#f3f0e8",
    "parameter": {
      "italic": true
    },
    "property": "#f3f0e8"
  }
}
