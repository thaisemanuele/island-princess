    "terminal.ansiBrightBlack": "#6c8576",
    "terminal.ansiRed": "#E2865C",
    "terminal.ansiBrightRed": "#EDA17E",
    "terminal.ansiGreen": "#4FC9A6",
    "terminal.ansiBrightGreen": "#A8E6D3",
    "terminal.ansiYellow": "#E8AD62",
    "terminal.ansiBrightYellow": "#F0C68C",
    "terminal.ansiBlue": "#4fc9a6",
    "terminal.ansiBrightBlue": "#84d9c1",
    "terminal.ansiMagenta": "#e7b798",
    "terminal.ansiBrightMagenta": "#eecdb7",
    "terminal.ansiCyan": "#8eddc4",
    "terminal.ansiBrightCyan": "#b0e7d6",
    "terminal.ansiWhite": "#d7d8c5",
    "terminal.ansiBrightWhite": "#ece8d4"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a9c92",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#4fc9a6"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#E2865C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#E8AD62"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#4fc9a6"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#4fc9a6"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#a8e6d3"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#a8e6d3"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a8e6d3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f5b9a6"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E8AD62",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E8AD62"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e2865c",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#a8e6d3",
    "method": "#a8e6d3",
    "class": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "type": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "interface": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "enum": {
      "foreground": "#E8AD62",
      "italic": true
    },
    "enumMember": {
      "foreground": "#e2865c",
      "italic": true
    },
    "property.declaration": "#ece8d4",
    "parameter": {
      "italic": true
    },
    "property": "#ece8d4"
  }
}
