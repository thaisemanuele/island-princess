    "editorGutter.addedBackground": "#a8e6d3",
    "editorGutter.deletedBackground": "#f08a9a",
    "editor.findMatchHighlightBackground": "#8eddc422",
    "editor.wordHighlightBackground": "#8eddc41f",
    "editor.selectionHighlightBackground": "#8eddc41f",
    "textLink.foreground": "#8eddc4",
    "textLink.activeForeground": "#b0e7d6",
