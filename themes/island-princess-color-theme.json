    "gitDecoration.stageModifiedResourceForeground": "#8eddc4",
    "gitDecoration.untrackedResourceForeground": "#a8e6d3",
    "gitDecoration.addedResourceForeground": "#a8e6d3",
    "gitDecoration.renamedResourceForeground": "#a8e6d3",
    "gitDecoration.deletedResourceForeground": "#f08a9a",
    "gitDecoration.stageDeletedResourceForeground": "#f08a9a",
    "gitDecoration.conflictingResourceForeground": "#f08a9a",
    "gitDecoration.ignoredResourceForeground": "#375c4f",
    "gitDecoration.submoduleResourceForeground": "#9eac9b",
