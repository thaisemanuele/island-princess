    "titleBar.activeForeground": "#9eac9b",
    "statusBar.foreground": "#9eac9b",
    "panelTitle.activeForeground": "#ece8d4",
    "panelTitle.inactiveForeground": "#6c8576",
    "panelTitle.activeBorder": "#E2865C",
    "terminal.foreground": "#ece8d4",
    "activityBarTop.foreground": "#E2865C",
