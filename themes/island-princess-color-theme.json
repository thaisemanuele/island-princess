    "sideBar.foreground": "#c9cdba",
    "sideBar.border": "#0a1412",
    "sideBarTitle.foreground": "#9eac9b",
    "sideBarSectionHeader.background": "#0a1412",
    "sideBarSectionHeader.foreground": "#9eac9b",
    "sideBarSectionHeader.border": "#122a24",
    "list.activeSelectionForeground": "#ece8d4",
    "list.inactiveSelectionBackground": "#122a24",
    "list.inactiveSelectionForeground": "#d7d8c5",
    "list.hoverForeground": "#ece8d4",
    "tree.indentGuidesStroke": "#1f4e41",
    "activityBar.inactiveForeground": "#A9B5A6",
