    "modernActivityBarItem.activeBackground": "#183A31",
    "modernActivityBarItem.hoverForeground": "#E2865C",
    "modernActivityBarItem.hoverBackground": "#122a24",
    "modernActivityBar.border": "#122a24",
    "modernEditorTab.activeBackground": "#0f1a18",
    "modernEditorTab.activeForeground": "#ece8d4",
